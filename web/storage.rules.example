rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['accountant','payroll_accountant','manager','admin','administrator']);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/.*|image/.*|text/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
