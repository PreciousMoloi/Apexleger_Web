rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && userDoc().data.role is string ? userDoc().data.role : 'client'; }
    function isStaff() { return role() in ['accountant', 'payroll_accountant', 'manager', 'admin', 'administrator']; }
    function isAdmin() { return role() in ['manager', 'admin', 'administrator']; }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin() || resource.data.role in ['accountant','payroll_accountant'] || (isStaff() && resource.data.role == 'client');
      allow create: if (isSelf(uid) && request.resource.data.role == 'client' && request.resource.data.uid == uid) || isAdmin();
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'open');
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid
        || resource.data.assignedAccountantId == request.auth.uid
        || resource.data.accountantId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (isAdmin()
        || (isStaff() && (resource.data.assignedAccountantId == request.auth.uid || resource.data.accountantId == request.auth.uid))
        || (resource.data.clientId == request.auth.uid
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description','updatedAt'])));
      allow delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid
        || resource.data.accountantId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (isAdmin() || (isStaff() && resource.data.accountantId == request.auth.uid));
      allow delete: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);

      match /chunks/{chunkId} {
        function parentDoc() { return get(/databases/$(database)/documents/documents/$(documentId)); }
        allow create: if signedIn() && parentDoc().data.clientId == request.auth.uid;
        allow read: if signedIn() && (parentDoc().data.clientId == request.auth.uid
          || parentDoc().data.accountantId == request.auth.uid || isAdmin());
        allow delete: if signedIn() && (parentDoc().data.clientId == request.auth.uid || isAdmin());
      }
    }

    match /threads/{threadId} {
      allow create: if signedIn() && (request.resource.data.clientId == request.auth.uid
        || (isStaff() && request.resource.data.accountantId == request.auth.uid));
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid
        || resource.data.accountantId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (signedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.accountantId == request.auth.uid)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.accountantId == resource.data.accountantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessagePreview','updatedAt','isUrgent']));
      allow delete: if isAdmin();
      match /messages/{messageId} {
        function parentThread() { return get(/databases/$(database)/documents/threads/$(threadId)); }
        allow read: if signedIn() && (parentThread().data.clientId == request.auth.uid
          || parentThread().data.accountantId == request.auth.uid || isAdmin());
        allow create: if signedIn() && (parentThread().data.clientId == request.auth.uid
          || parentThread().data.accountantId == request.auth.uid || isAdmin())
          && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && (parentThread().data.clientId == request.auth.uid
          || parentThread().data.accountantId == request.auth.uid || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn();
    }
    match /audit_log/{logId} { allow read: if isAdmin(); allow create: if signedIn(); }
    match /counters/{c} { allow read, write: if signedIn(); }
    match /ticket_notes/{t} { allow read, write: if isStaff(); }
    match /{document=**} { allow read, write: if false; }
  }
}
